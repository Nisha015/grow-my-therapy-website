# Copy to .env.local for local development and add the same keys in
# Vercel → Project → Settings → Environment Variables.
#
# Public site URL (used for canonical URLs, sitemap, Open Graph).
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=

# Optional contact details. The profile did not include these, so nothing is
# shown until you provide real values. When set, the contact buttons switch
# from "Get directions" to "Email" / "Call" automatically.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Optional external booking link (takes priority over email/phone).
NEXT_PUBLIC_BOOKING_URL=
